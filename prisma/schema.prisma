generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum RecommendationStatus {
  RECOMMENDED
  MIXED_FEELINGS
  NOT_RECOMMENDED
}

enum GameStatus {
  PLAYING
  COMPLETED
  ON_BACKLOG
  DROPPED
}

model User {
  id         String    @id @default(uuid())
  name       String    @unique
  email      String    @unique
  password   String
  avatarUrl  String?   
  role       Role      @default(USER)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  passwordResetToken   String?
  passwordResetExpires DateTime?

  nameChangeLockedUntil DateTime?

  logs       UserGameLog[]
}

model Game {
  id          String   @id @default(uuid())
  title       String   @unique
  platform    String
  genre       String[]
  releaseYear Int
  coverUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  logs        UserGameLog[]
}

model UserGameLog {
  id                   String     @id @default(uuid())
  rating               Int?
  comment              String?    @db.VarChar(300)
  recommendation       RecommendationStatus?
  playtimeHours        Float?
  achievementsEarned   Int        @default(0)
  isPlatininated       Boolean    @default(false)
  status               GameStatus @default(PLAYING)
  startedAt            DateTime?
  finishedAt           DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String
  game   Game   @relation(fields: [gameId], references: [id])
  gameId String

  @@unique([userId, gameId])
}